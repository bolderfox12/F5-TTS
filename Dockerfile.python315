FROM python:3.15.2-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 git build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/F5-TTS
COPY . .
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir "torch>=2.15.0" torchaudio --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir . \
    && python -m pip check

VOLUME /root/.cache/huggingface/hub/
EXPOSE 7860
CMD ["f5-tts_infer-gradio", "--host", "0.0.0.0", "--port", "7860"]
